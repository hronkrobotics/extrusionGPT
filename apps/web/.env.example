# --- Planner (optional) ---
# When set, natural-language requests are parsed with OpenAI Structured Outputs.
# When unset, a built-in deterministic parser is used instead (app still works).
OPENAI_API_KEY=
# Optional: override the extraction model (default: gpt-4o-mini)
OPENAI_PLANNER_MODEL=gpt-4o-mini

# --- Persistence (optional) ---
# When set, /api/designs endpoints save versioned design documents to Postgres.
# Works great with Supabase (use the connection string / pooler URL).
# When unset, the app runs fully in-memory (no saving).
DATABASE_URL=
